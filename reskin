#!/usr/bin/env bash
set -eou pipefail

# SAVE OPTION
wall=detach

WALL_DIR=$HOME/pix/walls/all_wall

RED='\033[0;31m'
RESET='\033[0m'

THEMES_DIR=$HOME/skps/themes

random_flag=0
if [[ $# -eq 1 && $1 == "-r" ]]; then
  random_flag=1
fi

# Prioritize command-line arg
if  [[ $# -eq 1 && $1 != "-r" ]]; then
  wall=$1
  node_name=$1
# If no save, or -r is passed, select random wall
elif [ -z ${wall+x} ] || [ "$random_flag" -eq 1 ]; then
  # TODO: assert random wall is different than current to force change
  node_name=$(ls -1 $WALL_DIR | shuf -n 1)
  wall=$WALL_DIR/$node_name
# Else execute save
else
  node_name=$wall
  wall=$WALL_DIR/$wall
fi

# Set
xwallpaper --zoom $wall

# Clear wal data
wal -c

echo -e "${RED}reskin: $node_name${RESET}"
echo -e "${RED}reskin: locating: $node_name.json${RESET}"

if [[ -f "$THEMES_DIR/$node_name.json" ]]; then
  echo -e "${RED}reskin: theme file found${RESET}"
  wal -a 92 -f "$THEMES_DIR/$node_name.json"
  echo -e "${RED}reskin: applied saved theme${RESET}"
else
  echo -e "${RED}reskin: no theme file${RESET}"
  wal -a 92 -i $wall
  echo -e "${RED}reskin: theme generated by wal${RESET}"
fi

# dmenu
nohup bash -c "$HOME/.config/polybar/bar.sh" 2>&1 > /dev/null &
cp $HOME/.cache/wal/colors-wal-dmenu.h $HOME/git/suckless-hakirot/dmenu
cd $HOME/git/suckless-hakirot/dmenu
make
make clean

# dunstrc notifications
frame_color=$(sed -n '2p' ${HOME}/.cache/wal/colors)
sed -i "s/frame_color = \"#[0-9A-Fa-f]\{6\}\"/frame_color = \"$frame_color\"/g" ${HOME}/.config/dunst/dunstrc
background=$(awk 'NR == 2 {print $2}' ${HOME}/.cache/wal/colors-kitty.conf)
sed -i "s/background = \"#[0-9A-Fa-f]\{6\}\"/background = \"$background\"/g" ${HOME}/.config/dunst/dunstrc
foreground=$(sed -n '8p' ${HOME}/.cache/wal/colors)
sed -i "s/foreground = \"#[0-9A-Fa-f]\{6\}\"/foreground = \"$foreground\"/g" ${HOME}/.config/dunst/dunstrc
dunst_restart
